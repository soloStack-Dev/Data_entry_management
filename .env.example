# Copy this file to ".env" and adjust the values, then Docker Compose picks it up
# automatically. ".env" is listed in .gitignore, so real passwords never reach Git.
#
#   copy .env.example .env        (Windows:  Copy-Item .env.example .env)
#
# The application also reads this file when it is started WITHOUT Docker, so the
# same values configure `mvnw spring-boot:run`. Real environment variables always
# win over this file, so Docker Compose and CI are unaffected.

# --- Database ---------------------------------------------------------------
DB_NAME=data_entry_db
DB_USERNAME=datauser
DB_PASSWORD=datapassword
DB_ROOT_PASSWORD=rootpassword

# Host-side port that maps to MySQL's 3306 inside the container.
# Change it if another MySQL already uses 3306 on this machine.
#
# When the application runs on the host, it uses this value as its database port.
DB_HOST_PORT=3306

# --- Application ------------------------------------------------------------
# Host-side port for the web application, published by Docker Compose.
APP_PORT=8081

# Host-side port for the application when it runs on the host instead of in a
# container (mvnw spring-boot:run). Setting it to a different port than APP_PORT
# lets Docker and a local run work at the same time without a port clash.
# Optional - when omitted, APP_PORT is used.
MAVEN_APP_PORT=8082
