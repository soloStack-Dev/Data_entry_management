# Copy this file to ".env" and adjust the values, then Docker Compose picks it up
# automatically. ".env" is listed in .gitignore, so real passwords never reach Git.
#
#   copy .env.example .env

# --- Database ---------------------------------------------------------------
DB_NAME=data_entry_db
DB_USERNAME=datauser
DB_PASSWORD=datapassword
DB_ROOT_PASSWORD=rootpassword

# Host-side port that maps to MySQL's 3306 inside the container.
# Change it if another MySQL already uses 3306 on this machine.
DB_HOST_PORT=3306

# --- Application ------------------------------------------------------------
# Host-side port for the web application.
APP_PORT=8081
